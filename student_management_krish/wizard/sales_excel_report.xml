<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="sale_excel_report_wizard" model="ir.ui.view">
        <field name="name">sale.excel.report.wizard.view</field>
        <field name="model">sale.report.wizard</field> 
        <field name="arch" type="xml">
            <form string="Sales Excel Report">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id" />
                        </group>  
                        <group>
                            <field name="start_date" required="1" />
                            <field name="end_date" required="1" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Download" type="object" name="download_report" class="btn-primary" />
                </footer>
            </form>
        </field>
        
    </record>
    <record id="action_sale_excel_report" model="ir.actions.act_window">
        <field name="name">Sales Excel Report</field> 
        <field name="res_model">sale.report.wizard</field> 
        <field name="view_mode">form</field> 
        <field name="target">new</field>
        <field name="view_id" ref="sale_excel_report_wizard" />
    </record>
</odoo> 